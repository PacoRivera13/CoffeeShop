{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:coverage-check && cross-env PLAYWRIGHT_BROWSERS_PATH=0 ng test --no-watch",
    "gen:api": "ng-openapi-gen --config ng-openapi-gen.json",
    "test:coverage-check": "node scripts/coverage-check.mjs",
    "e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "e2e:install": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "material-symbols": "^0.49.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@vitest/browser-playwright": "^5.1.1",
    "cross-env": "^10.1.0",
    "jsdom": "^31.0.0",
    "ng-openapi-gen": "^1.1.0",
    "playwright": "^1.65.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
