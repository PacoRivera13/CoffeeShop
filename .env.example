# LOCAL DEVELOPMENT ONLY. Every value below is a throwaway default for a machine-local stack; never reuse any of
# them in a shared, staging or production environment. Copy to .env (git-ignored) and change what you like.
# Read by Docker Compose and by scripts/dev.ps1 / scripts/dev.sh.

# Goes into the connection string, so avoid ';'. SQL Server needs 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=LocalOnly-Sql-2026!
# Used only by the compose `api` service; scripts/dev keeps its own key in dotnet user-secrets and ignores this one.
# Leave empty until you set a random value of 32+ characters: the containerised API refuses to start without it.
Jwt__Key=
Jwt__Issuer=coffeeshop
Jwt__Audience=coffeeshop
# The Admin user is seeded at startup only when both values are set; an existing user keeps its password.
Admin__Email=admin@coffeeshop.local
Admin__Password=LocalOnly-Admin-2026!
# MinIO root credentials, also used by the API as its storage keys. The password needs 8+ characters.
MINIO_USER=coffeeshop
MINIO_PASSWORD=LocalOnly-Minio-2026!
# Demo customer created by the demo seed (scripts/dev sets Seed__Demo=true; Development only).
Seed__CustomerEmail=customer@coffeeshop.local
Seed__CustomerPassword=LocalOnly-Customer-2026!
