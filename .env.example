MSSQL_SA_PASSWORD=change-me
# Leave Jwt__Key empty until you set a random value of 32+ characters: the API refuses to start without it.
Jwt__Key=
Jwt__Issuer=coffeeshop
Jwt__Audience=coffeeshop
# The Admin user is seeded at startup only when both values are set.
Admin__Email=
Admin__Password=
# MinIO root credentials, also used by the api service as its storage keys. The password needs 8+ characters.
MINIO_USER=coffeeshop
MINIO_PASSWORD=
# Storage for an API started with dotnet run outside Docker (Development defaults cover endpoint and bucket).
Storage__Bucket=coffeeshop-invoices
Storage__AccessKey=
Storage__SecretKey=
